{
  "info": {
    "_postman_id": "60f2a52f-b07c-4fb1-929d-f8cc98bd63f3",
    "name": "CryptoDeepApp Exchange API",
    "description": "Examples for the documented CryptoDeepApp Exchange API GET endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Get currencies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains coins', function () {",
              "  pm.expect(pm.response.json().coins).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Get available coins and networks.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/currencies?page={{page}}&limit={{limit}}&search={{currencySearch}}"
        }
      },
      "response": []
    },
    {
      "name": "Get rate by deposit amount",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains rate fields', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('depositAmount');",
              "  pm.expect(body).to.have.property('receiveAmount');",
              "  pm.expect(body).to.have.property('rate');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Calculate a rate from depositAmount.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/rate?depositCoin={{depositCoin}}&receiveCoin={{receiveCoin}}&depositAmount={{depositAmount}}&rateMode={{rateMode}}&depositNetwork={{depositNetwork}}&receiveNetwork={{receiveNetwork}}"
        }
      },
      "response": []
    },
    {
      "name": "Get rate by receive amount",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains rate fields', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('depositAmount');",
              "  pm.expect(body).to.have.property('receiveAmount');",
              "  pm.expect(body).to.have.property('rate');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Calculate a rate from receiveAmount.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/rate?depositCoin={{depositCoin}}&receiveCoin={{receiveCoin}}&receiveAmount={{receiveAmount}}&rateMode={{rateMode}}&depositNetwork={{depositNetwork}}&receiveNetwork={{receiveNetwork}}"
        }
      },
      "response": []
    },
    {
      "name": "Get one transaction",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains uniqueId', function () {",
              "  pm.expect(pm.response.json()).to.have.property('uniqueId');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Get a transaction by uniqueId.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/transaction?id={{transactionId}}"
        }
      },
      "response": []
    },
    {
      "name": "Get transactions",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains transactions', function () {",
              "  pm.expect(pm.response.json().transactions).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Get transactions with pagination and search.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions?page={{page}}&limit={{limit}}&search={{transactionSearch}}"
        }
      },
      "response": []
    }
  ]
}
