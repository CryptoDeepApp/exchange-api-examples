{
  "info": {
    "_postman_id": "fe849f10-638b-43d0-b6a1-8cfef1aa7708",
    "name": "CryptoDeepApp Exchange API - Create Transaction",
    "description": "Manually guarded example for POST /api/v1/transaction. This request creates a real exchange transaction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create transaction",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const confirmationVariable = 'confirmTransactionCreation';",
              "const expectedConfirmation = 'CREATE_REAL_TRANSACTION';",
              "const confirmation = pm.environment.get(confirmationVariable);",
              "pm.environment.set(confirmationVariable, 'false');",
              "",
              "if (confirmation !== expectedConfirmation) {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response contains uniqueId', function () {",
              "  pm.expect(pm.response.json()).to.have.property('uniqueId');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"depositCoin\": \"{{depositCoin}}\",\n  \"depositAmount\": {{depositAmount}},\n  \"depositNetwork\": \"{{depositNetwork}}\",\n  \"receiveCoin\": \"{{receiveCoin}}\",\n  \"receiveNetwork\": \"{{receiveNetwork}}\",\n  \"receiveAddress\": \"{{receiveAddress}}\",\n  \"rateMode\": \"{{rateMode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Creates a real exchange transaction. Set confirmTransactionCreation to CREATE_REAL_TRANSACTION immediately before sending. The confirmation resets after one attempt.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/transaction"
        }
      },
      "response": []
    }
  ]
}
