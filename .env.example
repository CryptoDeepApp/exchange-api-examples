# Public API origin. Keep HTTPS for non-local environments.
CRYPTODEEP_BASE_URL=https://api.cryptodeep.app

# Required. Paste your authorized token here, with or without the "Bearer " prefix.
# Never commit a real value.
CRYPTODEEP_API_KEY=

# Optional request timeout in milliseconds.
CRYPTODEEP_TIMEOUT_MS=15000

# Currency-list example.
CRYPTODEEP_PAGE=1
CRYPTODEEP_LIMIT=20
CRYPTODEEP_SEARCH=BTC

# Rate and estimate examples.
CRYPTODEEP_DEPOSIT_COIN=BTC
CRYPTODEEP_DEPOSIT_NETWORK=BTC
CRYPTODEEP_RECEIVE_COIN=XMR
CRYPTODEEP_RECEIVE_NETWORK=XMR
CRYPTODEEP_RATE_MODE=fixed
CRYPTODEEP_DEPOSIT_AMOUNT=0.01
CRYPTODEEP_RECEIVE_AMOUNT=1

# Transaction examples. Set an ID created by the same partner account.
CRYPTODEEP_TRANSACTION_ID=
CRYPTODEEP_TRANSACTION_SEARCH=
